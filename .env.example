
# ─────────────────────────────────────────────
#  IBM watsonx.ai Configuration
# ─────────────────────────────────────────────
WATSONX_API_KEY=aZP_dpBOLpoBH2MmXrODLAqSgzRN6UAG01XJ97VEkBz7
WATSONX_PROJECT_ID=d2be2c10-b24e-4054-b324-1e8fa543e0ad
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_REGION=us-south

# IBM Granite Model
GRANITE_MODEL_ID=ibm/granite-4-8b-instruct
GRANITE_MAX_TOKENS=4096
GRANITE_TEMPERATURE=0.7
GRANITE_TOP_P=0.95

# ─────────────────────────────────────────────
#  IBM Cloud Configuration
# ─────────────────────────────────────────────
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here
IBM_CLOUD_REGION=us-south
IBM_CLOUD_RESOURCE_GROUP=default

# IBM COS (Cloud Object Storage) for file components
IBM_COS_API_KEY=your_cos_api_key_here
IBM_COS_INSTANCE_CRN=your_cos_instance_crn_here
IBM_COS_BUCKET_NAME=finance-agent-files
IBM_COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud

# ─────────────────────────────────────────────
#  Vector Index / RAG Configuration
# ─────────────────────────────────────────────
VECTOR_DB_TYPE=chromadb
VECTOR_DB_PATH=./data/vector_store
VECTOR_COLLECTION_NAME=finance_knowledge
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RESULTS=5

# ─────────────────────────────────────────────
#  Application Configuration
# ─────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=production
SECRET_KEY=your_secret_key_here_change_in_production
DEBUG=false

# ─────────────────────────────────────────────
#  Cache / Memory
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600
SESSION_TTL=86400

# ─────────────────────────────────────────────
#  Market Data APIs
# ─────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
NEWS_API_KEY=your_newsapi_key_here
FINNHUB_API_KEY=your_finnhub_key_here
